# Copy to .streamlit/secrets.toml locally/platform-side.
# Never commit the real secrets.toml.
#
# Production Yahoo/OIDC callback must be an explicit HTTPS URL. Do not use
# loopback addresses, Vercel preview hosts, or request Host headers.
# Set the same value in the Yahoo Developer application.
#
# Production runtime:
#   AUCTION_ENV=production
#   OIDC_ENV, if set, must resolve to the same runtime as AUCTION_ENV.
#   Conflicting OIDC_ENV and AUCTION_ENV values fail closed.
#   OIDC_REDIRECT_URI=https://<canonical-streamlit-host>/oauth2callback
#   [auth].redirect_uri must match OIDC_REDIRECT_URI exactly.
#   Loopback callbacks are rejected, including IPv6 and alternate IPv4 forms.
#
# Local development only:
#   AUCTION_ENV=development
#   Use an explicit local HTTP or HTTPS callback in the uncommitted
#   secrets.toml. The runtime validator accepts either scheme on
#   loopback in development. Production still requires HTTPS and
#   rejects loopback. Yahoo currently requires HTTPS even locally.
#   Example: https://localhost:8501/oauth2callback
#   Streamlit serves HTTPS directly when both --server.sslCertFile
#   and --server.sslKeyFile are supplied.

[auth]
redirect_uri = "https://YOUR-STREAMLIT-HOST/oauth2callback"
cookie_secret = "GENERATE_A_LONG_RANDOM_SECRET"
client_id = "OIDC_CLIENT_ID"
client_secret = "OIDC_CLIENT_SECRET"
server_metadata_url = "https://api.login.yahoo.com/.well-known/openid-configuration"

# Yahoo compatibility: prompt=consent is documented by Yahoo and shows the
# consent screen on every login. It replaces Streamlit's default
# prompt=select_account, which Yahoo does not document.
[auth.client_kwargs]
scope = "openid email profile"
response_type = "code"
prompt = "consent"
